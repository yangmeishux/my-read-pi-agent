{
  "providers": {
    "deepseek": {
      "baseUrl": "$DEEPSEEK_BASE_URL",
      "api": "openai-completions",
      "apiKey": "$DEEPSEEK_API_KEY",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false,
        "maxTokensField": "max_tokens"
      },
      "models": [
        {
          "id": "deepseek-chat",
          "name": "DeepSeek Chat",
          "reasoning": false,
          "input": ["text"],
          "contextWindow": 1000000,
          "maxTokens": 8192
        }
      ]
    }
  }
}
